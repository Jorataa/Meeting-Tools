# Server only. Use your existing keys; never use NEXT_PUBLIC_ for Gemini.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Legacy names remain supported for existing installations.
GEMINI_API_KEY=
# Optional comma-separated fallback keys. Server only; never use NEXT_PUBLIC_.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
# Dedicated streaming speech recognition. Requires Live Transcription model access.
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
# Optional server-side TTS override. Default: Gemini 3.8 Flash-Lite TTS.
GEMINI_TTS_MODEL=
SESSION_SECRET=
# Supabase publishable keys are designed for client use; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
